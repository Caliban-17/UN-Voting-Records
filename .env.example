# Data Sources
UN_DIGITAL_LIBRARY_URL=https://digitallibrary.un.org
UN_VOTING_DATA_PATH=2025_03_31_ga_voting_corr1.csv

# Performance Optimization (reduce CPU load)
# Limit dataset for faster processing (0 = no limit, use full dataset)
MAX_ROWS_TO_LOAD=0
# Reduce workers for lower CPU usage (1-4 recommended)
MAX_WORKERS=2
# Chunk size for processing (smaller = lower memory, but slower)
CHUNK_SIZE=5000

# Caching Configuration
CACHE_DIR=.cache
CACHE_TTL_HOURS=24
USE_PARQUET_CACHE=true

# Web Scraping Configuration
SCRAPING_DELAY_SECONDS=2
MAX_RETRIES=3
USER_AGENT=UN-Voting-Analyzer/1.0

# Update Schedule (cron format)
# Default: Daily at 2 AM UTC
AUTO_UPDATE_CRON=0 2 * * *
ENABLE_AUTO_UPDATE=true

# Reverse proxies you run in front of the app (0 = none). Only then is
# X-Forwarded-For trusted for rate limiting; clients can forge it otherwise.
TRUSTED_PROXY_COUNT=0

# Automatic research publication and current-context collection.
# Starts with web_app.py; no editor, paid model or newsletter account required.
PULSE_AUTO_REFRESH=1
PULSE_REFRESH_SECONDS=1800
# PULSE_DATA_DIR=data/pulse

# Network Analysis Configuration
DEFAULT_SIMILARITY_THRESHOLD=0.7
MIN_EDGE_WEIGHT=0.5

# Soft Power Weights (must sum to 1.0)
PAGERANK_WEIGHT=0.4
BETWEENNESS_WEIGHT=0.3
EIGENVECTOR_WEIGHT=0.2
VOTE_SWAYING_WEIGHT=0.1

# Temporal Weighting for Historical Data
# Exponential decay factor (higher = more recent bias)
TEMPORAL_DECAY_FACTOR=0.95

# Performance Settings
MAX_WORKERS=4
CHUNK_SIZE=10000

# Logging
LOG_LEVEL=INFO
LOG_FILE=output.log

# Hosting (set on Railway, not locally)
# SITE_PASSWORD=            # when set, the whole site needs it except /subscribe, /unsubscribe, /health
# PUBLIC_URL=               # base for links in emails; defaults to https://$RAILWAY_PUBLIC_DOMAIN
# SMTP_HOST= SMTP_PORT=465 SMTP_USER= SMTP_PASS= SMTP_FROM=   # newsletter delivery; nothing is sent without them
# NEWSLETTER_MIN_DAYS=7     # at most one edition email per this many days
